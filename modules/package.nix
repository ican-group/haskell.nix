{ lib, options, config, pkgs, haskellLib, ... }:

# Work around issue that can cause _lots_ of files to be copied into the store.
# See https://github.com/NixOS/nixpkgs/pull/64691
let
  inherit (haskellLib.types) listOfFilteringNulls;
  inherit (lib) types;

  path = types.path // { check = x: types.path.check (x.origSrc or x); };

  componentType = types.submodule [
    ./component.nix
    { _module.args = { inherit pkgs haskellLib; }; }
    # pass down common options as default values
    ({ lib, options, ... }: lib.mkDefault (lib.filterAttrs (n: _v: builtins.hasAttr n options) config))
  ];

in
{
  imports = [
    ./component-options.nix
    ./package-options.nix
  ];

  # This is how the Nix expressions generated by *-to-nix receive
  # their flags argument.
  config._module.args = { inherit (config) flags; };

  options = {
    flags = lib.mkOption {
      description = ''
        The package's Cabal flags, by name.  The plan's flag choices are set
        as defaults, so a module can override one.
      '';
      type = types.attrsOf types.bool;
    };

    package = {
      specVersion = lib.mkOption {
        description = ''
          The package's `cabal-version`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      identifier.name = lib.mkOption {
        description = "The package name.";
        type = types.str;
      };

      identifier.version = lib.mkOption {
        description = "The package version.";
        type = types.str;
      };

      identifier.id = lib.mkOption {
        description = "`<name>-<version>`.";
        type = types.str;
        default = "${config.package.identifier.name}-${config.package.identifier.version}";
        defaultText = "\${config.package.identifier.name}-\${config.package.identifier.version}";
      };

      # cabal-install unit-id from plan.json's per-entry `id`.
      # Set by `modules/install-plan/planned.nix` for plan-id-keyed
      # packages.  Null when not derived from a plan.json entry
      # (e.g. setup deps before plan resolution).
      identifier.unit-id = lib.mkOption {
        description = ''
          The unit id `cabal-install` gave the package in `plan.json` (its
          `id`), or `null` when the package does not come from a plan entry.
        '';
        type = types.nullOr types.str;
        default = null;
      };

      # The pkg-config names the `.cabal` file declares, every component,
      # under the plan's flags (`pkgconfNamesOf` in lib/load-cabal-plan.nix).
      pkgconfNames = lib.mkOption {
        type = types.listOf types.str;
        internal = true;
        default = [];
      };

      # The `build-depends` of every component the `.cabal` file declares,
      # planned or not, under the plan's flags, keyed by component id
      # (`pkg:test:t`), as Cabal names (`dep`, or `pkg:sublib` for a
      # sub-library); `componentDependNamesOf` in lib/load-cabal-plan.nix.
      # Only set for project packages, on one unit per package (`{}` on the
      # rest).  `haskellLib.mkFlake` uses it to find sub-libraries only unbuilt
      # components use (#2028).
      componentDependNames = lib.mkOption {
        type = types.attrsOf (types.listOf types.str);
        internal = true;
        default = {};
      };

      license = lib.mkOption {
        description = ''
          The package's `license`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      copyright = lib.mkOption {
        description = ''
          The package's `copyright`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      maintainer = lib.mkOption {
        description = ''
          The package's `maintainer`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      author = lib.mkOption {
        description = ''
          The package's `author`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      homepage = lib.mkOption {
        description = ''
          The package's `homepage`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      url = lib.mkOption {
        description = ''
          The package's `package-url`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      synopsis = lib.mkOption {
        description = ''
          The package's `synopsis`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
        default = "";
      };

      description = lib.mkOption {
        description = ''
          The package's `description`.  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      buildType = lib.mkOption {
        description = ''
          The package's `build-type` (`Simple`, `Configure`, `Make` or
          `Custom`).  From the `.cabal` file (set by the generated package expression).
        '';
        type = types.str;
      };

      setup-depends = lib.mkOption {
        description = ''
          The dependencies of the package's `custom-setup` stanza, used to
          build its `Setup`.
        '';
        type = listOfFilteringNulls types.unspecified;
        default = [ ];
      };

      detailLevel = lib.mkOption {
        description = ''
          How much of the `.cabal` file the generated expression describes:
          `"FullDetails"` (with source files and directories) lets haskell.nix
          filter each component's source down to the files it uses (with
          `builderVersion = 1`); `"MinimalDetails"` does not.
        '';
        type = types.str;
        default = "MinimalDetails";
      };

      licenseFiles = lib.mkOption {
        description = ''
          The package's `license-files`.  Used to work out the component's
          source files (with `builderVersion = 1`).
        '';
        type = listOfFilteringNulls types.unspecified;
        default = [ ];
      };

      dataDir = lib.mkOption {
        description = ''
          The package's `data-dir`.  Used to work out the component's source
          files (with `builderVersion = 1`).
        '';
        type = types.str;
        default = "";
      };

      dataFiles = lib.mkOption {
        description = ''
          The package's `data-files`.  Used to work out the component's source
          files (with `builderVersion = 1`).
        '';
        type = listOfFilteringNulls types.unspecified;
        default = [ ];
      };

      extraSrcFiles = lib.mkOption {
        description = ''
          The package's `extra-source-files`.  Used to work out the component's
          source files (with `builderVersion = 1`).
        '';
        type = listOfFilteringNulls types.unspecified;
        default = [ ];
      };

      extraTmpFiles = lib.mkOption {
        description = "The package's `extra-tmp-files`.";
        type = listOfFilteringNulls types.unspecified;
        default = [ ];
      };

      extraDocFiles = lib.mkOption {
        description = ''
          The package's `extra-doc-files`.  Used to work out the component's
          source files (with `builderVersion = 1`).
        '';
        type = listOfFilteringNulls types.unspecified;
        default = [ ];
      };

      cleanHpack = lib.mkOption {
        description = ''
          For a package whose `.cabal` file is generated by hpack, filter each
          component's source to the files it uses anyway (keeping files the
          `package.yaml` includes from parent directories).  Without it the
          whole package source is used.  Only applies with `builderVersion = 1`.
        '';
        type = types.bool;
        default = false;
      };

      isLocal = lib.mkOption {
        description = ''
          Set for local packages: the project's own and those from
          `source-repository-package`s (or git and local `extra-deps` with
          stack).  `shellFor` provides their dependencies rather than the
          packages, and `localPackages` options apply to them.
        '';
        type = types.bool;
        default = false;
      };

      # Package in `hsPkgs` that is a composite pointing components of the packages keyed by UnitID
      isRedirect = lib.mkOption {
        internal = true;
        description = ''
          Set on `hsPkgs.<name>` records that only point at the plan's
          unit-id-keyed packages (with `builderVersion = 2`).
        '';
        type = types.bool;
        default = false;
      };

      isProject = lib.mkOption {
        description = ''
          Set for the project's own packages (not those from
          `source-repository-package`s).  `projectPackages` options apply to
          them, and they are what the flake outputs are made for.
        '';
        type = types.bool;
        default = false;
      };

      buildable = lib.mkOption {
        description = ''
          Set to `false` in a module to leave the whole package out (none of
          its components are built or included in shells).
        '';
        type = types.bool;
        default = true;
      };
    };

    components = {
      setup = lib.mkOption {
        description = ''
          The package's `Setup` (for `build-type: Custom` packages, or the
          default one), used to build it with `builderVersion = 1`.
        '';
        type = types.nullOr componentType;
        default = {
          depends = [ ];
          libs = [ ];
          frameworks = [ ];
          doExactConfig = false;
          # We have to set hsSourceDirs or cleanCabalComponent will
          # include everything (and as a result all the components of
          # the package will depend on everything in the package).
          # TODO find a better way
          hsSourceDirs = [ "setup-src" ];
          includeDirs = [ ];
          asmSources = [ ];
          cSources = [ ];
          cmmSources = [ ];
          cxxSources = [ ];
          jsSources = [ ];
          extraSrcFiles = [ "Setup.hs" "Setup.lhs" ];
          platforms = null;
        };
      };

      library = lib.mkOption {
        description = ''
          The package's library, or `null` if it has none.
        '';
        type = types.nullOr componentType;
        default = null;
      };

      sublibs = lib.mkOption {
        description = ''
          The package's sub-libraries, by name.
        '';
        type = types.attrsOf componentType;
        default = { };
      };

      foreignlibs = lib.mkOption {
        description = ''
          The package's foreign libraries, by name.
        '';
        type = types.attrsOf componentType;
        default = { };
      };

      exes = lib.mkOption {
        description = ''
          The package's executables, by name.
        '';
        type = types.attrsOf componentType;
        default = { };
      };

      tests = lib.mkOption {
        description = ''
          The package's test suites, by name.
        '';
        type = types.attrsOf componentType;
        default = { };
      };

      benchmarks = lib.mkOption {
        description = ''
          The package's benchmarks, by name.
        '';
        type = types.attrsOf componentType;
        default = { };
      };
    };

    name = lib.mkOption {
      description = ''
        `<name>-<version>`, used in derivation names.
      '';
      type = types.str;
      default = "${config.package.identifier.name}-${config.package.identifier.version}";
      defaultText = "\${config.package.identifier.name}-\${config.package.identifier.version}";
    };

    # Does this record describe a package, or is it only an alias target?
    #
    # The plan defines `packages.<UnitID>`; `packages.<pkg-name>` exists so
    # that a module can override a package by name, and
    # modules/install-plan/override-package-by-name.nix copies those
    # definitions onto every matching id.  So a single
    # `packages.foo.patches = [...]` in configuration-nix.nix -- or a
    # `packages.foo.additional-prebuilt-depends` from the stable-haskell
    # boot-package injection -- is enough to make `options.packages.foo`
    # *defined* while nothing ever gives it a `package`.  Building such a
    # record throws "The option `packages.foo.package.identifier.version'
    # was accessed but has no value defined".
    #
    # `options.packages.<name>.package…` is not reachable from outside the
    # submodule (the nested options only exist in here), which is why this
    # is an option rather than a check at the use site.
    hasPackageDefinition = lib.mkOption {
      type = types.bool;
      internal = true;
      default = options.package.identifier.name.isDefined;
      defaultText = "options.package.identifier.name.isDefined";
    };

    sha256 = lib.mkOption {
      description = ''
        The hash of the package's Hackage tarball, used by the default `src`.
      '';
      type = types.nullOr types.str;
      default = null;
    };

    src = lib.mkOption {
      description = ''
        The package source.  Defaults to the Hackage tarball (when `sha256` is
        set); local packages have their directory in the project.
      '';
      type = types.nullOr (types.either path types.package);
      default =
        if options.package.identifier.name.isDefined && options.package.identifier.version.isDefined && options.sha256.isDefined
          then
             pkgs.fetchurl {
              url = "mirror://hackage/${config.name}.tar.gz";
              inherit (config) sha256;
            }
          else null;
      defaultText = ''
        pkgs.fetchurl {
          url = "mirror://hackage/$'{config.name}.tar.gz";
          inherit (config) sha256;
        };
      '';
      # Make sure paths have a context so they will be included in the derivation
      # inputs for the component derivations.  Without this sandbox builds fail
      # cannot see the input and fail with the error:
      #   do not know how to unpack source archive /nix/store/...
      apply = v:
        let storeDirMatch = builtins.match "(${builtins.storeDir}/[^/]+).*" v;
        in if builtins.isString v && builtins.getContext v == { } && storeDirMatch != null
        then builtins.appendContext v { ${builtins.head storeDirMatch} = { path = true; }; }
        else v;
    };

    package-description-override = lib.mkOption {
      type = types.nullOr types.str;
      default = null;
      description = "Cabal file to use instead of the one shipped inside the package source distribution.";
    };

    cabal-generator = lib.mkOption {
      description = ''
        `"hpack"` when the package's `.cabal` file is generated from its
        `package.yaml`: the builders run hpack on the source first.
      '';
      type = types.nullOr types.str;
      default = null;
    };

    revision = lib.mkOption {
      description = ''
        The Hackage revision of the package's `.cabal` file (`0` is the one in
        the tarball).
      '';
      type = types.nullOr types.int;
      default = null;
    };

    revisionSha256 = lib.mkOption {
      description = ''
        The hash of the revised `.cabal` file (from hackage.nix).
      '';
      type = types.nullOr types.str;
      default = null;
    };

    patches = lib.mkOption {
      description = ''
        Patches applied to the package source.  An entry may be a function of
        `{ version, ... }` returning a patch or `null`, to apply it only to
        some versions.  With `builderVersion = 2`, prefer listing the patched
        source under `packages:` in `cabalProjectLocal`: patches here make
        the package's source, and so its unit id, differ from the plan's.
      '';
      type = types.listOf (types.either types.unspecified path);
      default = [ ];
    };

    # This used to be `components.all` but it has been added back as `allComponent` to
    # to avoid confusion.  It is not mapped by `builder/hspkg-builder.nix` to anything
    # you can build.  Instead it is used internally when `configureAllComponents`
    # is set or for tests whe on `cabal-doctest` is in the `setup-depends` of the package.
    allComponent = lib.mkOption {
      type = componentType;
      apply = all: all // {
        # TODO: Should this check for the entire component
        # definition to match, rather than just the identifier?
        depends = builtins.filter (p: p.identifier != config.package.identifier) all.depends;
      };
      description = "The merged dependencies of all other components";
    };
  };

  # This has one quirk. Manually setting options on the all component
  # will be considered a conflict. This is almost always fine; most
  # settings should be modified in either the package options, or an
  # individual component's options. When this isn't sufficient,
  # mkForce is a reasonable workaround.
  #
  # An alternative solution to mkForce for many of the options where
  # this is relevant would be to switch from the bool type to
  # something like an anyBool type, which would merge definitions by
  # returning true if any is true.
  config.allComponent =
    let allComps = haskellLib.getAllComponents config;
    in lib.mkMerge
      (
        builtins.map
          (c:
            # Exclude attributes that are likely to have conflicting definitions
            # (a common use case for `all` is in `shellFor` and it only has an
            # install phase).
            builtins.removeAttrs c [ "preCheck" "postCheck" "keepConfigFiles" "keepGhc" "keepSource" ]
          )
          (lib.filter (c: c.buildable && c.planned) allComps)
      );
}
