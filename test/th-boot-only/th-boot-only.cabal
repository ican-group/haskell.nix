cabal-version:      3.0
name:               th-boot-only
version:            0.1.0.0
license:            BSD-3-Clause
build-type:         Simple

library
    exposed-modules:  Lib
    build-depends:    base, template-haskell
    hs-source-dirs:   src
    default-language: Haskell2010

executable th-boot-only
    main-is:          Main.hs
    build-depends:    base, th-boot-only
    hs-source-dirs:   app
    default-language: Haskell2010
