cabal-version: 2.2
name:          project-packages
version:       0.1.0.0
license:       BSD-3-Clause
build-type:    Simple

executable project-packages
  main-is:          Main.hs
  hs-source-dirs:   src
  -- A small Hackage package, so the plan has a non-local package that
  -- `projectPackages`/`localPackages` must leave alone.
  build-depends:    base, data-default-class
  default-language: Haskell2010
