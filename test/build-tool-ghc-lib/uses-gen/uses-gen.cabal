cabal-version: 2.4
name:          uses-gen
version:       0.1.0.0
build-type:    Simple

library
  exposed-modules:    UsesGen
  hs-source-dirs:     src
  build-depends:      base
  build-tool-depends: ghc-lib-gen:ghc-lib-gen
  default-language:   Haskell2010

executable uses-gen
  main-is:          Main.hs
  build-depends:    base, uses-gen
  default-language: Haskell2010
