# The project's `hpack` option picks the hpack that turns `package.yaml`
# into a `.cabal` file, instead of the one that ships with nix-tools.  The
# package (test/cabal-hpack) has no `.cabal` file, so plan-to-nix runs the
# chosen hpack (`supportHpack`), and so do the builders and `sdist`.  The
# `.cabal` file in the sdist tarball names the hpack version that wrote it.
#
# The version is not the one in nix-tools (0.39.1 when this was written),
# so the check fails if the nix-tools hpack is used anywhere it should not
# be.  hpack is a build-platform tool, so the cross variants of this test
# would only build the same hpack again.
{ stdenv, lib, project', testSrc, compiler-nix-name, evalPackages, evalSystem, buildPackages }:

let
  hpackVersion = "0.38.1";

  project = project' {
    inherit compiler-nix-name evalSystem;
    src = testSrc "cabal-hpack";
    supportHpack = true;
    hpack = hpackVersion;
    modules = [{
      # Package has no exposed modules which causes
      #   haddock: No input file(s)
      packages.cabal-hpack.doHaddock = false;
    }];
  };

  packages = project.hsPkgs;
  packagesV2 = (project.appendModule { builderVersion = 2; }).hsPkgs;

in lib.recurseIntoAttrs {
  meta.disabled = stdenv.hostPlatform != stdenv.buildPlatform;

  ifdInputs = {
    inherit (project) plan-nix;
  };

  run = stdenv.mkDerivation {
    name = "cabal-hpack-version-test";
    nativeBuildInputs = [ buildPackages.gnutar buildPackages.gzip ];

    buildCommand = ''
      # The builders ran the chosen hpack too (the v1 component builder,
      # and the v2 one, which runs hpack in local packages).
      echo ${packages.cabal-hpack.components.exes.cabal-hpack.exePath}
      echo ${packagesV2.cabal-hpack.components.exes.cabal-hpack.exePath}

      tar -xzf ${packages.cabal-hpack.sdist.tarball} --wildcards '*/cabal-hpack.cabal'
      head -5 */cabal-hpack.cabal
      if ! grep -q 'by hpack version ${hpackVersion}\.' */cabal-hpack.cabal; then
        echo "FAIL: the .cabal file was not generated by hpack ${hpackVersion}" >&2
        exit 1
      fi

      touch $out
    '';

    meta = {
      platforms = lib.platforms.all;
    };

    passthru = {
      # Used for debugging with nix repl
      inherit project packages;
    };
  };
}
