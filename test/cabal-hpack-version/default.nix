# The project's `hpack` option picks the hpack that turns `package.yaml`
# into a `.cabal` file.  It runs on the project source in a step of its own,
# and the `.cabal` file it writes is what plan-to-nix reads and what the
# package is built with, so the plan and the build agree.
#
# The hpack here is nix-tools' one plus a post-processing step that adds
# `cpp-options: -DCHOSEN_HPACK` and `build-depends: splitmix` to the
# executable, neither of which is in package.yaml:
#
#   * if plan-to-nix read package.yaml itself (with its built-in hpack), the
#     v1 component would not get `splitmix` and would fail to configure;
#   * if a builder ran hpack again, `Main.hs` would hit its `#error`.
#
# hpack also has to see the real source: the libraries list no modules
# (they are inferred; one of hpack-shared's `source-dirs` is outside its
# package directory), pkg/package.yaml includes ../common.yaml
# (`FROM_INCLUDE`), and hpack-choice's `license:` is inferred from its
# LICENSE file (checked in the sdist's `.cabal` file).
#
# Editing a source file must not re-plan the project: `plan-nix` for a copy
# of the source with an edited module is the same derivation.
{ stdenv, lib, project', testSrc, compiler-nix-name, evalPackages, evalSystem, buildPackages }:

let
  # Runs in the hpack step, so it is built for `evalSystem`.
  chosenHpack = evalPackages.writeShellScriptBin "hpack" ''
    set -euo pipefail
    ${evalPackages.haskell-nix.nix-tools-unchecked}/bin/hpack "$@"
    dir=.
    for a in "$@"; do
      case "$a" in
        *.yaml) dir=$(dirname "$a") ;;
      esac
    done
    for f in "$dir"/*.cabal; do
      ${evalPackages.gawk}/bin/awk '
        { print }
        /^executable / {
          print "  cpp-options: -DCHOSEN_HPACK"
          print "  build-depends: splitmix"
        }' "$f" > "$f.tmp"
      mv "$f.tmp" "$f"
    done
  '';

  src = testSrc "cabal-hpack-version";

  project = project' {
    inherit compiler-nix-name evalSystem src;
    supportHpack = true;
    hpack = chosenHpack;
  };
  projectV2 = project.appendModule { builderVersion = 2; };

  # Two plain copies of the test source, one with a module edited.
  copyOf = edit: evalPackages.runCommand "hpack-version-src" {} ''
    cp -r --no-preserve=mode ${src} $out
    ${edit}
  '';
  planNixFor = s: (project' {
    inherit compiler-nix-name evalSystem;
    src = s;
    supportHpack = true;
    hpack = chosenHpack;
  }).plan-nix;
  planNixCopy = planNixFor (copyOf "");
  planNixEdited = planNixFor (copyOf ''
    echo '-- edited' >> $out/pkg/src/HpackChoice/Inner.hs
  '');

  # A stable-haskell compiler only works with the v2 builder.
  onlyV2 = buildPackages.haskell-nix.compiler.${compiler-nix-name}.isStableHaskell or false;

  exeV1 = project.hsPkgs.hpack-choice.components.exes.hpack-choice;
  sharedV1 = project.hsPkgs.hpack-shared.components.library;
  exeV2 = projectV2.hsPkgs.hpack-choice.components.exes.hpack-choice;

in lib.recurseIntoAttrs {
  # The hpack runs on `evalSystem`; the cross variants would only build the
  # same package for another platform.
  meta.disabled = stdenv.hostPlatform != stdenv.buildPlatform;

  ifdInputs = {
    inherit (project) plan-nix;
    plan-nix-v2 = projectV2.plan-nix;
    inherit planNixCopy planNixEdited;
  };

  run = stdenv.mkDerivation {
    name = "cabal-hpack-version-test";
    nativeBuildInputs = [ buildPackages.gnutar buildPackages.gzip ];

    buildCommand = ''
      ${lib.concatMapStrings (exe: ''
        ${exe.exePath} > out
        cat out
        grep -q 'module inferred by hpack' out
      '') (lib.optional (!onlyV2) exeV1 ++ [ exeV2 ])}

      # hpack saw `../shared` (outside hpack-shared's directory), so the
      # module from it is in what plan-to-nix read, and the v1 build of the
      # library (which keeps sibling directories) finds it.
      grep -q '"HpackChoice/Shared"' $(find ${project.plan-nix} -path '*/.plan.nix/hpack-shared.nix')
      ${lib.optionalString (!onlyV2) "echo ${sharedV1}"}

      # plan-to-nix read the generated `.cabal` file (it did not mark the
      # package as generated by hpack).
      if grep -q cabal-generator $(find ${project.plan-nix} -path '*/.plan.nix/hpack-choice.nix'); then
        echo "FAIL: plan-to-nix read package.yaml instead of the generated .cabal file" >&2
        exit 1
      fi

      # `sdist` uses the same `.cabal` file, and it has the license hpack
      # inferred from LICENSE.
      tar -xzf ${project.hsPkgs.hpack-choice.sdist.tarball} --wildcards '*/hpack-choice.cabal'
      grep -q CHOSEN_HPACK */hpack-choice.cabal
      grep -Eq '^license: +BSD' */hpack-choice.cabal

      # Editing a module does not re-plan the project.
      if [ ${builtins.unsafeDiscardStringContext planNixCopy.drvPath} != ${builtins.unsafeDiscardStringContext planNixEdited.drvPath} ]; then
        echo "FAIL: editing a source file changed plan-nix" >&2
        exit 1
      fi

      touch $out
    '';

    meta = {
      platforms = lib.platforms.all;
    };

    passthru = {
      # Used for debugging with nix repl
      inherit project projectV2 planNixCopy planNixEdited;
    };
  };
}
