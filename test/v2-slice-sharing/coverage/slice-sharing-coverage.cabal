cabal-version: 2.2
name:          slice-sharing-coverage
version:       0.1.0.0
license:       LicenseRef-PublicDomain

library
  exposed-modules:  SliceSharing
  build-depends:    base, primitive
  default-language: Haskell2010

executable slice-sharing-coverage
  main-is:          Main.hs
  build-depends:    base
  -- the JS and wasm targets have no host zlib
  if !arch(javascript) && !arch(wasm32)
    pkgconfig-depends: zlib
  default-language: Haskell2010
