index-state: 2026-07-02T14:25:01Z
with-compiler: ghc-9.6

-- Needed for building aarch64-linux musl version with GHC 9.6
constraints: containers installed, Cabal >=3.16.1.0
allow-older: Cabal-syntax-json:base, Cabal-syntax-json:containers
allow-newer: Cabal-syntax-json:Cabal, Cabal-syntax-json:Cabal-syntax

packages: nix-tools

-- haskell.nix expects nix-tools to provide the cabal and hpack executables
-- so we put these two packages here, so they will be present even if nix-tools
-- dependencies change
extra-packages: cabal-install, hpack, Cabal-syntax-json

test-show-details: direct

allow-newer:
    -- nix-tools (and its deps) bound Cabal/Cabal-syntax to ^>=3.16;
    -- the stable-haskell fork below is 3.19.  Relax the upper bound on
    -- these deps project-wide so make-install-plan links the fork.
    Cabal,
    Cabal-syntax,
    cabal-install,
    cabal-install-solver,
    algebraic-graphs:deepseq,
    hackage-db:base,
    hackage-db:Cabal,
    hnix:aeson,
    hnix:base,
    hnix:bytestring,
    hnix:free,
    hnix:relude,
    hnix-store-core:base,
    hnix-store-core:bytestring,
    hnix-store-core:cryptonite,
    hnix-store-core:memory,
    hnix:template-haskell,
    hpack:Cabal,
    lens-family-th:base,
    lens-family-th:template-haskell,

source-repository-package
    type: git
    location: https://github.com/michaelpj/hackage-db.git
    tag: f3b9240212b036391871e4ea09891e91efcea7a1
    --sha256: sha256-n0ATmkwtR68E2FuZK3QIQgZirVmWbd21vIQmzhGKsRw=

source-repository-package
    type: git
    location: https://github.com/andreabedini/Cabal-syntax-json.git
    tag: b0033ed4d00a09340c64f4290cc649f4009deabd
    --sha256: sha256-Aymi25AQLSMextVeXbsMnaOppxAO93qVbwo7Vt44ej4=

-- Build make-install-plan against the stable-haskell cabal fork: branch
-- hkm/sh-merge2-ports, which is Andrea Bedini's `stable-haskell/merge`
-- (haskell/cabal master as of 2026-10-26, cabal-install 3.19, plus the
-- cross-compilation series haskell/cabal#12356: --with-build-compiler,
-- per-stage solving/elaboration/stores, `build:`/`exe` constraint
-- qualifiers and `package build:*`/`host:*` stanzas) with haskell.nix's
-- fork commits on top: installed instances satisfying named sub-library
-- deps, plan-node dedupe, unit receipts driving store reuse, Host-stage
-- scoping of executable-static, a per-stage `shared` default for targets
-- whose RTS linker only loads shared libraries (wasm), no -fPIC for
-- vanilla-way C on wasm, and shared libraries for the dependencies of a
-- native-shared foreign library.  This is the SAME rev the v2 builder's
-- cabal-install is pinned to (`haskell-nix.v2-cabal-install`,
-- overlays/haskell.nix), so plan-time and slice-time elaboration can never
-- skew.  The stage system is what lets the solver break the
-- Win32 -> hsc2hs -> process -> Win32 build-tool cycle by resolving
-- build-tool-depends in the build scope instead of relying on a full
-- Hackage "older universe".
source-repository-package
    type: git
    location: https://github.com/stable-haskell/Cabal.git
    tag: 32bf90171f5a981a9596a39ec4ee8e77fed29752
    --sha256: sha256-boyDU/kkFJGlr2m53dqBJU+h9BN6epwQi69tUu5fHTI=
    subdir: Cabal
            Cabal-syntax
            cabal-install
            cabal-install-solver
            hooks-exe
