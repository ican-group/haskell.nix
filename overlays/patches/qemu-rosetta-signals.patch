+/*
+ * Rosetta reports SEGV_MAPERR for writes to mapped, protected pages.
+ * Check the host mapping as well as QEMU's page metadata before allowing
+ * page_unprotect() to retry such a fault. An actual host mapping hole must
+ * remain a fault, including when QEMU's metadata says it is writable.
+ */
+static bool host_sigsegv_mapped_write(uintptr_t host_addr, abi_ptr guest_addr)
+{
+#ifdef __x86_64__
+    int saved_errno = errno;
+    int flags;
+    unsigned char vec;
+    uintptr_t host_page = host_addr & -qemu_real_host_page_size();
+    bool mapped;
+
+    mmap_lock();
+    flags = page_get_flags(guest_addr);
+    /* PAGE_WRITE may already be set by another faulting thread. */
+    mapped = (flags & (PAGE_VALID | PAGE_WRITE_ORG))
+             == (PAGE_VALID | PAGE_WRITE_ORG)
+             && mincore((void *)host_page, 1, &vec) == 0;
+    mmap_unlock();
+    errno = saved_errno;
+    return mapped;
+#else
+    return false;
+#endif
+}
