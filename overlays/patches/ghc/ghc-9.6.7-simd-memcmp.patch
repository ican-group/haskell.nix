-genMemCmp :: BlockId -> p -> CmmFormal -> CmmActual -> CmmActual -> CmmActual -> NatM InstrBlock
-genMemCmp bid _align res dst src n = do
-  -- TODO: generate inline assembly when under a given treshold (similarly to
-  -- memcpy and memset)
-  genLibCCall bid (fsLit "memcmp") [res] [dst,src,n]
+genMemCmp :: BlockId -> p -> CmmFormal -> CmmActual -> CmmActual -> CmmActual -> NatM (InstrBlock, Maybe BlockId)
+genMemCmp bid _align res dst src n_arg = do
+  is32Bit <- is32BitPlatform
+  case n_arg of
+    CmmLit (CmmInt n _) | not is32Bit, n >= 0 -> genMemCmpInline n
+    _ -> fallback
+  where
+    fallback = (,Nothing) <$> genLibCCall bid (fsLit "hs_memcmp") [res] [dst,src,n_arg]
+    genMemCmpInline :: Integer -> NatM (InstrBlock, Maybe BlockId)
+    genMemCmpInline n = do
+      config <- getConfig
+      let threshold = ncgInlineThresholdMemcpy config
+          res_r = getLocalRegReg res
+          resW = typeWidth (localRegType res)
+          moveRes32 :: Reg -> InstrBlock
+          moveRes32 r32 = case resW of
+            W32 -> unitOL (MOV II32 (OpReg r32) (OpReg res_r))
+            W64 -> unitOL (MOVSxL II32 (OpReg r32) (OpReg res_r))
+            _   -> unitOL (MOV II32 (OpReg r32) (OpReg res_r))
+      if n == 0
+        then do
+          let insns = 1 :: Word
+          if insns <= threshold
+            then return (unitOL (XOR II32 (OpReg res_r) (OpReg res_r)), Nothing)
+            else fallback
+        else if n == 1
+          then do
+            let insns = 3 :: Word
+            if insns > threshold
+              then fallback
+              else do
+                code_dst <- getAnyReg dst
+                p1_r <- getNewRegNat II64
+                code_src <- getAnyReg src
+                p2_r <- getNewRegNat II64
+                t1 <- getNewRegNat II32
+                t2 <- getNewRegNat II32
+                let addr1 = OpAddr (AddrBaseIndex (EABaseReg p1_r) EAIndexNone (ImmInt 0))
+                    addr2 = OpAddr (AddrBaseIndex (EABaseReg p2_r) EAIndexNone (ImmInt 0))
+                    code = code_dst p1_r `appOL` code_src p2_r `appOL` toOL
+                      [ MOVZxL II8 addr1 (OpReg t1)
+                      , MOVZxL II8 addr2 (OpReg t2)
+                      , SUB II32 (OpReg t2) (OpReg t1)
+                      ]
+                let fini = case resW of
+                      W32 | t1 == res_r -> nilOL
+                      _ -> moveRes32 t1
+                -- When res is W32 and t1 happens to be res_r, no move needed.
+                -- getNewRegNat always returns a fresh reg, so t1 /= res_r;
+                -- keep the general move.
+                return (code `appOL` fini, Nothing)
+          else if n == 2 || n == 4 || n == 8
+            then do
+              let insns = 8 :: Integer
+              if insns > toInteger threshold
+                then fallback
+                else do
+                  code_dst <- getAnyReg dst
+                  p1_r <- getNewRegNat II64
+                  code_src <- getAnyReg src
+                  p2_r <- getNewRegNat II64
+                  let (ldFmt1, ldFmt2, bswapFmt, cmpFmt, tFmt) = case n of
+                        2 -> (II16, II16, II32, II32, II32)
+                        4 -> (II32, II32, II32, II32, II32)
+                        _ -> (II64, II64, II64, II64, II64)
+                  t1 <- getNewRegNat tFmt
+                  t2 <- getNewRegNat tFmt
+                  hi8 <- getNewRegNat II8
+                  lo8 <- getNewRegNat II8
+                  r32 <- getNewRegNat II32
+                  lo32 <- getNewRegNat II32
+                  let addr1 = OpAddr (AddrBaseIndex (EABaseReg p1_r) EAIndexNone (ImmInt 0))
+                      addr2 = OpAddr (AddrBaseIndex (EABaseReg p2_r) EAIndexNone (ImmInt 0))
+                      ld1 = case n of
+                        2 -> MOVZxL ldFmt1 addr1 (OpReg t1)
+                        _ -> MOV ldFmt1 addr1 (OpReg t1)
+                      ld2 = case n of
+                        2 -> MOVZxL ldFmt2 addr2 (OpReg t2)
+                        _ -> MOV ldFmt2 addr2 (OpReg t2)
+                      code = code_dst p1_r `appOL` code_src p2_r `appOL` toOL
+                        [ ld1
+                        , ld2
+                        , BSWAP bswapFmt t1
+                        , BSWAP bswapFmt t2
+                        , CMP cmpFmt (OpReg t2) (OpReg t1)
+                        , SETCC GU (OpReg hi8)
+                        , SETCC LU (OpReg lo8)
+                        , MOVZxL II8 (OpReg hi8) (OpReg r32)
+                        , MOVZxL II8 (OpReg lo8) (OpReg lo32)
+                        , SUB II32 (OpReg lo32) (OpReg r32)
+                        ]
+                      fini = case resW of
+                        W32 | r32 == res_r -> nilOL
+                        _ -> moveRes32 r32
+                  return (code `appOL` fini, Nothing)
+            else do
+              let numChunks :: Integer
+                  numChunks
+                    | n == 3           = 2
+                    | n >= 5 && n <= 7 = 2
+                    | otherwise        = (n + 7) `div` 8
+                  insns :: Integer
+                  insns = 4 * numChunks
+              if insns > toInteger threshold || n > 0x7fffffff
+                then fallback
+                else do
+                  let (chunkBytes, cmpFmt, tFmt, offsets) = case n of
+                        3 -> (2 :: Integer, II32, II32, [0, 1])
+                        _ | n >= 5 && n <= 7 -> (4, II32, II32, [0, n - 4])
+                        _ -> let k = n `div` 8
+                                 base = [0, 8 .. (k - 1) * 8]
+                                 tailOff = if n `mod` 8 /= 0 then [n - 8] else []
+                             in (8, II64, II64, base ++ tailOff)
+                      m = length offsets
+                  code_dst <- getAnyReg dst
+                  p1_r <- getNewRegNat II64
+                  code_src <- getAnyReg src
+                  p2_r <- getNewRegNat II64
+                  t1 <- getNewRegNat tFmt
+                  t2 <- getNewRegNat tFmt
+                  r32 <- getNewRegNat II32
+                  one32 <- getNewRegNat II32
+                  lblEq <- getBlockIdNat
+                  lblDiff <- getBlockIdNat
+                  lblDone <- getBlockIdNat
+                  nextBlks <- mapM (const getBlockIdNat) [1 .. m - 1]
+                  let blkIds = bid : nextBlks
+                      nextIds = nextBlks ++ [lblEq]
+                      mkAddr :: Reg -> Integer -> Operand
+                      mkAddr base off = OpAddr (AddrBaseIndex (EABaseReg base) EAIndexNone (ImmInt (fromInteger off)))
+                      mkLoad :: Operand -> Reg -> Instr
+                      mkLoad addr tmp = case chunkBytes of
+                        2 -> MOVZxL II16 addr (OpReg tmp)
+                        4 -> MOV II32 addr (OpReg tmp)
+                        _ -> MOV II64 addr (OpReg tmp)
+                      -- Fast-path chunks, each in its own block.
+                      -- Note: the last chunk emits NEWBLOCK lblEq, so eqCode
+                      -- starts directly with lblEq's instructions!
+                      mkChunk :: (Integer, BlockId) -> InstrBlock
+                      mkChunk (off, nextId) =
+                        toOL
+                          [ mkLoad (mkAddr p1_r off) t1
+                          , mkLoad (mkAddr p2_r off) t2
+                          , CMP cmpFmt (OpReg t2) (OpReg t1)
+                          , JXX NE lblDiff
+                          , JXX ALWAYS nextId
+                          , NEWBLOCK nextId
+                          ]
+                      fastCode = concatOL (map mkChunk (zip offsets nextIds))
+                      eqCode = toOL
+                        [ XOR II32 (OpReg res_r) (OpReg res_r)
+                        , JXX ALWAYS lblDone
+                        ]
+                      -- Cold out-of-line diff: bswap to big-endian order,
+                      -- then unsigned compare to produce -1 / 1.
+                      diffCode = toOL
+                        [ NEWBLOCK lblDiff
+                        , BSWAP cmpFmt t1
+                        , BSWAP cmpFmt t2
+                        , CMP cmpFmt (OpReg t2) (OpReg t1)
+                        , MOV II32 (OpImm (ImmInt (-1))) (OpReg r32)
+                        , MOV II32 (OpImm (ImmInt 1)) (OpReg one32)
+                        , CMOV GU II32 (OpReg one32) r32
+                        ] `appOL` moveRes32 r32 `appOL` toOL
+                        [ JXX ALWAYS lblDone
+                        , NEWBLOCK lblDone
+                        ]
+                      code = code_dst p1_r `appOL` code_src p2_r `appOL` fastCode `appOL` eqCode `appOL` diffCode
+                  -- CFG update: successive statements now live in lblDone.
+                  addImmediateSuccessorNat bid lblDone
+                  updateCfgNat $ \cfg ->
+                    let cfg1 = delEdge bid lblDone cfg
+                        addChunkEdges c (blk, nxt) = addWeightEdge blk nxt 80 . addWeightEdge blk lblDiff 20 $ c
+                        cfg2 = foldl addChunkEdges cfg1 (zip blkIds nextIds)
+                        cfg3 = addWeightEdge lblEq lblDone 100 cfg2
+                        cfg4 = addWeightEdge lblDiff lblDone 100 cfg3
+                    in cfg4
+                  return (code, Just lblDone)
 
 genPrefetchData :: Int -> CmmExpr -> NatM (OrdList Instr)
 genPrefetchData n src = do
