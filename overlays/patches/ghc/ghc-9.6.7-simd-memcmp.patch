+	movzbl (%rdi,%r8),%eax
+	movzbl (%rsi,%r8),%edx
+	sub %edx,%eax
+	vzeroupper
+	ret
+.Lavx_diff96:
+	bsfl %r8d,%r8d
+	add %rax,%r8
+	add $96,%r8
+	movzbl (%rdi,%r8),%eax
+	movzbl (%rsi,%r8),%edx
+	sub %edx,%eax
+	vzeroupper
+	ret
+
+/* ---- Small sizes on the AVX2 path (SSE insns, vzeroupper on return) ---- */
+.Lavx_small:	/* 1 <= n < 32 */
+	cmp $16,%rdx
+	jae .Lavx_small16
+	cmp $8,%rdx
+	jae .Lavx_sm8
+	cmp $4,%rdx
+	jae .Lavx_sm4
+	cmp $2,%rdx
+	jae .Lavx_sm2
+	movzbl (%rdi),%eax
+	movzbl (%rsi),%edx
+	sub %edx,%eax
+	vzeroupper
+	ret
+.Lavx_small16:	/* 16 <= n <= 31 */
+	movdqu (%rdi),%xmm0
+	movdqu (%rsi),%xmm1
+	pcmpeqb %xmm1,%xmm0
+	pmovmskb %xmm0,%ecx
+	xor $0xffff,%ecx
+	jnz .Lavx_s16_diff0
+	mov %rdx,%rax
+	sub $16,%rax	/* rax = n-16, overlapping final block */
+	movdqu (%rdi,%rax),%xmm0
+	movdqu (%rsi,%rax),%xmm1
+	pcmpeqb %xmm1,%xmm0
+	pmovmskb %xmm0,%ecx
+	xor $0xffff,%ecx
+	jnz .Lavx_s16_difff
+	vzeroupper
+	xor %eax,%eax
+	ret
+.Lavx_s16_diff0:
+	bsfl %ecx,%ecx
+	movzbl (%rdi,%rcx),%eax
+	movzbl (%rsi,%rcx),%edx
+	sub %edx,%eax
+	vzeroupper
+	ret
+.Lavx_s16_difff:
+	bsfl %ecx,%ecx
+	add %rax,%rcx
+	movzbl (%rdi,%rcx),%eax
+	movzbl (%rsi,%rcx),%edx
+	sub %edx,%eax
+	vzeroupper
+	ret
+.Lavx_sm8:	/* 8 <= n <= 15 */
+	mov (%rdi),%rax
+	mov (%rsi),%rcx
+	cmp %rcx,%rax
+	jne .Lavx_sm8_d0
+	cmp $8,%rdx
+	je .Lavx_sm_ret0
+	mov %rdx,%r8
+	sub $8,%r8
+	mov (%rdi,%r8),%rax
+	mov (%rsi,%r8),%rcx
+	cmp %rcx,%rax
+	je .Lavx_sm_ret0
+	jmp .Lavx_sm8_res
+.Lavx_sm8_d0:
+	xor %r8d,%r8d
+.Lavx_sm8_res:
+	bswap %rax
+	bswap %rcx
+	xor %rcx,%rax
+	bsr %rax,%rax
+	shr $3,%rax
+	xor $7,%rax
+	add %r8,%rax
+	movzbl (%rdi,%rax),%ecx
+	movzbl (%rsi,%rax),%eax
+	sub %eax,%ecx
+	mov %ecx,%eax
+	vzeroupper
+	ret
+.Lavx_sm4:	/* 4 <= n <= 7 */
+	mov (%rdi),%eax
+	mov (%rsi),%ecx
+	cmp %ecx,%eax
+	jne .Lavx_sm4_d0
+	cmp $4,%rdx
+	je .Lavx_sm_ret0
+	mov %rdx,%r8
+	sub $4,%r8
+	mov (%rdi,%r8),%eax
+	mov (%rsi,%r8),%ecx
+	cmp %ecx,%eax
+	je .Lavx_sm_ret0
+	jmp .Lavx_sm4_res
+.Lavx_sm4_d0:
+	xor %r8d,%r8d
+.Lavx_sm4_res:
+	bswap %eax
+	bswap %ecx
+	xor %ecx,%eax
+	bsr %eax,%eax
+	shr $3,%eax
+	xor $3,%eax
+	add %r8,%rax
+	movzbl (%rdi,%rax),%ecx
+	movzbl (%rsi,%rax),%eax
+	sub %eax,%ecx
+	mov %ecx,%eax
+	vzeroupper
+	ret
+.Lavx_sm2:	/* 2 <= n <= 3 */
+	movzwl (%rdi),%eax
+	movzwl (%rsi),%ecx
+	cmp %cx,%ax
+	jne .Lavx_sm2_d0
+	cmp $2,%rdx
+	je .Lavx_sm_ret0
+	mov %rdx,%r8
+	sub $2,%r8
+	movzwl (%rdi,%r8),%eax
+	movzwl (%rsi,%r8),%ecx
+	cmp %cx,%ax
+	je .Lavx_sm_ret0
+	jmp .Lavx_sm2_res
+.Lavx_sm2_d0:
+	xor %r8d,%r8d
+.Lavx_sm2_res:
+	xchg %al,%ah
+	xchg %cl,%ch
+	xor %ecx,%eax
+	test $0xff00,%eax
+	jnz .Lavx_sm2_first
+	add $1,%r8
+.Lavx_sm2_first:
+	movzbl (%rdi,%r8),%ecx
+	movzbl (%rsi,%r8),%eax
+	sub %eax,%ecx
+	mov %ecx,%eax
+	vzeroupper
+	ret
+.Lavx_sm_ret0:
+	vzeroupper
+	xor %eax,%eax
+	ret
+
+.size hs_memcmp_simd,.-hs_memcmp_simd
