+                              ] `appOL` toOL revCode `appOL` toOL
+                              [ CMP (OpReg cmpW t1) (OpReg cmpW t2)
+                              , CSET (OpReg resOpW hi_r) UGT
+                              , CSET (OpReg resOpW lo_r) ULT
+                              , SUB (OpReg resOpW res_r) (OpReg resOpW hi_r) (OpReg resOpW lo_r)
+                              ]
+                        return (code, Nothing)
+                  else do
+                    let numChunks :: Integer
+                        numChunks
+                          | n == 3           = 2
+                          | n >= 5 && n <= 7 = 2
+                          | otherwise        = (n + 7) `div` 8
+                        insns :: Integer
+                        insns = 4 * numChunks
