+              then do
+                let insns = 1 :: Word
+                if insns <= threshold
+                  then return (unitOL (MOV (OpReg W32 res_r) (OpImm (ImmInt 0))), Nothing)
+                  else fallback
+              else if n == 1
+                then do
+                  let insns = 3 :: Word
+                  if insns > threshold
+                    then fallback
+                    else do
+                      (p1, _, code_p1) <- getSomeReg dst_a
+                      p1_r <- getNewRegNat II64
+                      (p2, _, code_p2) <- getSomeReg src_a
+                      p2_r <- getNewRegNat II64
+                      t1 <- getNewRegNat II32
+                      t2 <- getNewRegNat II32
+                      hi_r <- getNewRegNat (if resW == W64 then II64 else II32)
+                      lo_r <- getNewRegNat (if resW == W64 then II64 else II32)
+                      let resOpW = if resW == W64 then W64 else W32
+                          addr1 = OpAddr (AddrRegImm p1_r (ImmInt 0))
+                          addr2 = OpAddr (AddrRegImm p2_r (ImmInt 0))
+                          code = code_p1 `appOL` code_p2 `appOL` toOL
+                            [ MOV (OpReg W64 p1_r) (OpReg W64 p1)
+                            , MOV (OpReg W64 p2_r) (OpReg W64 p2)
+                            , LDR II8 (OpReg W8 t1) addr1
+                            , LDR II8 (OpReg W8 t2) addr2
+                            , CMP (OpReg W32 t1) (OpReg W32 t2)
+                            , CSET (OpReg resOpW hi_r) UGT
+                            , CSET (OpReg resOpW lo_r) ULT
+                            , SUB (OpReg resOpW res_r) (OpReg resOpW hi_r) (OpReg resOpW lo_r)
+                            ]
+                      return (code, Nothing)
+                else if n == 2 || n == 4 || n == 8
+                  then do
+                    let insns = 8 :: Integer
+                    if insns > toInteger threshold
+                      then fallback
+                      else do
+                        (p1, _, code_p1) <- getSomeReg dst_a
+                        p1_r <- getNewRegNat II64
+                        (p2, _, code_p2) <- getSomeReg src_a
+                        p2_r <- getNewRegNat II64
+                        let chunkBytes = n
+                            (ldFmt, ldW, cmpW) = case n of
+                              2 -> (II16, W16, W32)
+                              4 -> (II32, W32, W32)
+                              _ -> (II64, W64, W64)
+                        t1 <- getNewRegNat (if cmpW == W64 then II64 else II32)
+                        t2 <- getNewRegNat (if cmpW == W64 then II64 else II32)
+                        hi_r <- getNewRegNat (if resW == W64 then II64 else II32)
+                        lo_r <- getNewRegNat (if resW == W64 then II64 else II32)
+                        let resOpW = if resW == W64 then W64 else W32
