+                              (off_r, _, c) <- getSomeReg (CmmLit (CmmInt lastOff W64))
+                              let mkA base off
+                                    | canUseImm off = OpAddr (AddrRegImm base (ImmInt (fromInteger off)))
+                                    | otherwise     = OpAddr (AddrRegReg base off_r)
+                              return (c, mkA p1_r, mkA p2_r)
+                            else do
+                              let mkA base off = OpAddr (AddrRegImm base (ImmInt (fromInteger off)))
+                              return (nilOL, mkA p1_r, mkA p2_r)
+                        let -- Note: the last chunk emits NEWBLOCK lblEq, so eqCode
+                            -- starts directly with lblEq's instructions!
+                            mkChunk :: (Integer, BlockId) -> InstrBlock
+                            mkChunk (off, nextId) =
+                              toOL
+                                [ LDR ldFmt (OpReg ldW t1) (addr1 off)
+                                , LDR ldFmt (OpReg ldW t2) (addr2 off)
+                                , CMP (OpReg cmpW t1) (OpReg cmpW t2)
+                                , BCOND NE (TBlock lblDiff)
+                                , B (TBlock nextId)
+                                , NEWBLOCK nextId
+                                ]
+                            fastCode = concatOL (map mkChunk (zip offsets nextIds))
+                            eqCode = toOL
+                              [ MOV (OpReg W32 res_r) (OpImm (ImmInt 0))
+                              , B (TBlock lblDone)
+                              ]
+                            revCode = if isLE && chunkBytes > 1
+                              then [ REV (OpReg cmpW t1) (OpReg cmpW t1)
+                                   , REV (OpReg cmpW t2) (OpReg cmpW t2) ]
+                              else []
+                            diffCode = toOL
+                              ([ NEWBLOCK lblDiff ] ++ revCode ++
+                              [ CMP (OpReg cmpW t1) (OpReg cmpW t2)
+                              , CSET (OpReg resOpW hi_r) UGT
+                              , CSET (OpReg resOpW lo_r) ULT
+                              , SUB (OpReg resOpW res_r) (OpReg resOpW hi_r) (OpReg resOpW lo_r)
+                              , B (TBlock lblDone)
+                              , NEWBLOCK lblDone
+                              ])
+                            code = code_p1 `appOL` code_p2 `appOL` offCode `appOL` toOL
+                              [ MOV (OpReg W64 p1_r) (OpReg W64 p1)
+                              , MOV (OpReg W64 p2_r) (OpReg W64 p2)
+                              ] `appOL` fastCode `appOL` eqCode `appOL` diffCode
+                        -- Keep the NCG CFG consistent when returning Just lblDone
+                        -- (mirrors X86 genMemCmpInline so liveness/CFG passes stay in sync).
+                        addImmediateSuccessorNat bid lblDone
+                        updateCfgNat $ \cfg ->
+                          let cfg1 = delEdge bid lblDone cfg
+                              addChunkEdges c (blk, nxt) =
+                                addWeightEdge blk nxt 80 . addWeightEdge blk lblDiff 20 $ c
+                              cfg2 = foldl addChunkEdges cfg1 (zip blkIds nextIds)
+                              cfg3 = addWeightEdge lblEq lblDone 100 cfg2
+                              cfg4 = addWeightEdge lblDiff lblDone 100 cfg3
+                          in cfg4
+                        return (code, Just lblDone)
+          | otherwise -> mkCCall "hs_memcmp"
 
         MO_SuspendThread    -> mkCCall "suspendThread"
         MO_ResumeThread     -> mkCCall "resumeThread"
