-        MO_Memcmp  _align   -> mkCCall "memcmp"
+        MO_Memcmp  _align
+          | [dst_a, src_a, CmmLit (CmmInt n _)] <- arg_regs
+          , [res_reg] <- dest_regs
+          , n >= 0 -> do
+            config <- getConfig
+            plat2 <- getPlatform
+            let threshold = ncgInlineThresholdMemcpy config
+                res_r = getRegisterReg plat2 (CmmLocal res_reg)
+                resW = typeWidth (localRegType res_reg)
+                isLE = platformByteOrder plat2 == LittleEndian
+                fallback = mkCCall "hs_memcmp"
