+                              _ | n >= 5 && n <= 7 -> (4, W32, II32, W32)
+                              _ -> (8, W64, II64, W64)
+                            offsets = case n of
+                              3 -> [0, 1]
+                              _ | n >= 5 && n <= 7 -> [0, n - 4]
+                              _ -> let k = n `div` 8
+                                       base = [0, 8 .. (k - 1) * 8]
+                                       tailOff = if n `mod` 8 /= 0 then [n - 8] else []
+                                   in base ++ tailOff
+                            m = length offsets
+                            canUseImm off = off `mod` chunkBytes == 0 && 0 <= off && off < 4096 * chunkBytes
+                        (p1, _, code_p1) <- getSomeReg dst_a
+                        p1_r <- getNewRegNat II64
+                        (p2, _, code_p2) <- getSomeReg src_a
+                        p2_r <- getNewRegNat II64
+                        t1 <- getNewRegNat (if cmpW == W64 then II64 else II32)
+                        t2 <- getNewRegNat (if cmpW == W64 then II64 else II32)
+                        hi_r <- getNewRegNat (if resW == W64 then II64 else II32)
+                        lo_r <- getNewRegNat (if resW == W64 then II64 else II32)
+                        lblEq <- getBlockIdNat
+                        lblDiff <- getBlockIdNat
+                        lblDone <- getBlockIdNat
+                        nextBlks <- mapM (const getBlockIdNat) [1 .. m - 1]
+                        let resOpW = if resW == W64 then W64 else W32
+                            nextIds = nextBlks ++ [lblEq]
+                            blkIds = bid : nextBlks
+                            lastOff = last offsets
+                        (offCode, addr1, addr2) <-
+                          if not (canUseImm lastOff)
